# MCP CATASTRO ESPAÑA - CONFIGURACIÓN EJEMPLO
# Copia este archivo como .env y personaliza los valores

# Configuración básica
CATASTRO_DEBUG=false
CATASTRO_LOG_LEVEL=INFO
CATASTRO_LOG_SENSITIVE_DATA=false
CATASTRO_CATASTRO_TIMEOUT=30
CATASTRO_CATASTRO_MAX_RETRIES=3
CATASTRO_CATASTRO_RETRY_DELAY=1.0

# OpenAI (opcional - deja vacío para usar modo simulado)
CATASTRO_OPENAI_API_KEY=
CATASTRO_OPENAI_MODEL=gpt-4
CATASTRO_OPENAI_TEMPERATURE=0.3
